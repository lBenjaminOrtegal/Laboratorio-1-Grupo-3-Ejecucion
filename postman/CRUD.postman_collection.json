    "_postman_id": "cf9a1ac2-5c80-4f05-8340-be91f807ed47",
    "description": "Ejecutar en orden. Crear y borrar datos de prueba propios. No requiere token. Configurar baseUrl con el puerto del backend."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
