  "item": [
    {
      "name": "01 Crear usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "usuarios"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Perez\",\n  \"correo\": \"ana.{{$guid}}@ejemplo.cl\",\n  \"contrasena\": \"ClaveLaboratorio123\",\n  \"rol\": \"ASISTENTE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201)) ;",
              "const d=pm.response.json().data; pm.collectionVariables.set(\"usuarioId\",d.id); pm.test(\"Sin contraseña\",()=>pm.expect(d).not.to.have.property(\"contrasena\"));"
            ]
          }
        }
      ],
      "response": []
    },
